# Generate a private identity once with `graphnet agent genkey` (print its
# public key with `GRAPHNET_PRIVATE_KEY=... graphnet agent key`).
GRAPHNET_PRIVATE_KEY=
# Copy the controller's public ca.pem to GRAPHNET_CA using a trusted channel.
GRAPHNET_SERVER=https://controller.example.com:8443
# Controller carrier: tcp (default), websocket, grpc, wss or https.
GRAPHNET_SERVER_TRANSPORT=tcp
GRAPHNET_CA=/etc/graphnet/ca.pem
GRAPHNET_NAME=linux-node
# Generate a one-time token in the UI. Ignored automatically once enrolled; remove after first start.
GRAPHNET_ENROLLMENT_TOKEN=replace-before-first-start
